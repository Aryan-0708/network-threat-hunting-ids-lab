alert http 192.0.2.20 any -> 192.0.2.10 8000 (msg:"SOC LAB - Custom HTTP User-Agent Detected"; flow:established,to_server; http.user_agent; content:"SOC-LAB-Scanner"; sid:1000001; rev:1;)

alert tcp 192.0.2.10 any -> 192.0.2.20 any (msg:"SOC LAB - Possible TCP SYN Port Scan"; flags:S; flow:stateless; threshold:type threshold, track by_src, count 10, seconds 10; sid:1000002; rev:1;)
